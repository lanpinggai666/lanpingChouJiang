<Page
    x:Class="lanpingcj.Views.Pages.StudentManagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="名单管理"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ui:TextBlock Text="当前名单内容" FontTypography="BodyStrong" Margin="0,0,0,8" />

            <Border Grid.Row="1" BorderThickness="1" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="4">
                <ListView x:Name="StudentListView" BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <ui:SymbolIcon Symbol="Person24" Margin="0,0,8,0" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="14"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
            <ui:Button Content="添加" Click="AddButton_Click" Margin="0,0,0,12" Appearance="Primary" Width="100" Icon="{ui:SymbolIcon ChevronLeft24}" />
            <ui:Button Content="删除选中" Click="DeleteButton_Click" Margin="0,0,0,12"  Width="100" Icon="{ui:SymbolIcon Delete24}" />
            <ui:Button Content="清空名单" Click="ClearButton_Click" Width="100" Icon="{ui:SymbolIcon Broom24}" />
        </StackPanel>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ui:TextBlock Text="批量添加" FontTypography="BodyStrong" Margin="0,0,0,8" />
            <ui:TextBox x:Name="InputTextBox" Grid.Row="1"
                        PlaceholderText="在这里填入名字，支持多行批量输入，一行一个..."
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalContentAlignment="Top" />
            <ui:TextBlock Grid.Row="2" Text="提示：点击“添加”按钮将内容合并到左侧名单" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,8,0,0" />
        </Grid>
    </Grid>
</Page>